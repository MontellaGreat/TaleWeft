{
  "name": "taleweft",
  "private": true,
  "description": "叙织 · TaleWeft — 面向长篇小说的 AI 创作工作台",
  "version": "0.1.0-preview.1",
  "type": "module",
  "scripts": {
    "sync:taxonomy": "node scripts/sync-builtin-taxonomy.mjs",
    "check:shared-config": "node scripts/sync-builtin-taxonomy.mjs --check",
    "predev": "npm run sync:branding && npm run sync:taxonomy",
    "prebuild": "node scripts/sync-release.mjs && npm run sync:branding && npm run sync:taxonomy",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:unit": "vitest run",
    "test:e2e": "vue-tsc --noEmit -p tests/e2e/tsconfig.json && playwright test",
    "check:release": "node scripts/sync-release.mjs --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sync:branding": "node scripts/sync-branding.mjs"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.14.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.3.3",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.5",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "happy-dom": "^21.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.5",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
